#
# Pinned toolchain container: same tree, same binaries, any machine.
# The host-side version audit is scripts/docker-build.sh (it compares
# gcc/binutils/qemu against 3rd/manifest.yaml).
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
ARG http_proxy=
ARG https_proxy=
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-aarch64-linux-gnu \
        binutils-aarch64-linux-gnu \
        qemu-system-arm \
        device-tree-compiler \
        python3 \
        make \
        ca-certificates \
        git \
        curl \
        xz-utils \
        bzip2 \
        file \
        gdb-multiarch \
        flex \
        bison \
        bc \
        libssl-dev \
        libelf-dev \
    && rm -rf /var/lib/apt/lists/*
# QEMU virt resolves efi-virtio.rom from ipxe-qemu; the Ubuntu
# qemu-system-arm package alone omits it and boot fails with
# "failed to find romfile efi-virtio.rom".
RUN apt-get update && apt-get install -y --no-install-recommends ipxe-qemu \
    && rm -rf /var/lib/apt/lists/*
ENV LC_ALL=C
ENV ESHINE_WORK=/work
WORKDIR /src