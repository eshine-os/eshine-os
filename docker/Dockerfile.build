#
# 站六十三:构建环境容器——工具链的运输形态。基座 ubuntu:24.04(noble)
# 与宿主同源:apt 交付的 cross 工具链版本与 3rd/manifest.yaml 的
# prebuilt pin(gcc 13.3.0 / binutils 2.42 / qemu 8.2.2)同源即同
# pin;scripts/docker-build.sh 在容器内实采对账(台账记的版本与容器
# 长出的版本必须逐字相等——pin 是对账出来的,不是注释出来的)。
#
# 件面(全部构建链先决):
#   gcc-aarch64-linux-gnu / binutils-aarch64-linux-gnu  cross 工具链
#   qemu-system-arm                                   验证平台(virt)
#   device-tree-compiler                              make -B 重建 dtb
#   python3 / make / ca-certificates                  gen_ramfs+脚本面
#
# 用法:docker build -f docker/Dockerfile.build .
#      (判据=scripts/docker-build.sh:build 后容器内重建全链)

FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-aarch64-linux-gnu \
        binutils-aarch64-linux-gnu \
        qemu-system-arm \
        device-tree-compiler \
        python3 \
        make \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
